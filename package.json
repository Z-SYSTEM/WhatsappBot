{
  "name": "whatsapp-bot",
  "version": "1.0.6",
  "type": "module",
  "description": "WhatsApp Bot usando Baileys",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node src/index.js",
    "start": "node src/index.js",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:Test": "jest --testNamePattern=\"Test - /api/test endpoint\"",
    "test:Contact": "jest --testNamePattern=\"Contact - /api/contact endpoint\"",
    "test:Group": "jest --testNamePattern=\"Group - /api/group endpoint\"",
    "test:Send": "jest --testNamePattern=\"Send - /api/send endpoint\"",
    "test:PDF": "jest --testNamePattern=\"PDF document\"",
    "test:RateLimit": "jest --testNamePattern=\"Rate Limit - /api/rate-limit-stats endpoint\"",
    "test:specific": "jest --testNamePattern"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "axios": "^1.17.0",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fs-extra": "^11.3.5",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
